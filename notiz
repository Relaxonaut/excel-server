# ==================================================
# MODUL SPEICHERN
# ==================================================

@app.put(
    "/api/modules/{module_id}",
    dependencies=[Depends(ui_auth)]
)
async def save_module(
    module_id: str,
    request: Request
):

    mod = Module.registry.get(module_id)

    if mod is None:
        raise HTTPException(
            404,
            "Modul unbekannt"
        )

    try:

        body = await request.json()

        # Globale Einstellungen
        werte = {}

        for field in mod.settings:

            raw = body.get(
                "werte", {}
            ).get(
                field.name,
                field.default
            )

            werte[field.name] = coerce(
                field,
                raw
            )

        # Mehrfachberechnungen
        raw_instances = body.get(
            "berechnungen",
            []
        )

        if not isinstance(raw_instances, list):
            raise ValueError(
                "berechnungen muss eine Liste sein."
            )

        berechnungen = []
        verwendete_ids = set()

        for index, instance in enumerate(
            raw_instances,
            start=1
        ):

            instance_id = str(
                instance.get("id") or index
            )

            if instance_id in verwendete_ids:
                raise ValueError(
                    f"Doppelte Berechnungs-ID: {instance_id}"
                )

            verwendete_ids.add(instance_id)

            zellen = {}

            for field in mod.inputs:

                adresse = str(
                    instance.get(
                        "zellen", {}
                    ).get(
                        field.name,
                        field.cell or ""
                    )
                ).strip()

                if adresse:
                    # Zelladresse validieren
                    cell_value([], adresse)

                zellen[field.name] = adresse

            berechnungen.append({

                "id": instance_id,

                "name": str(
                    instance.get(
                        "name",
                        f"Berechnung {index}"
                    )
                ),

                "aktiv": bool(
                    instance.get("aktiv", True)
                ),

                "zellen": zellen,
            })

        # Gesamtkonfiguration
        config = {

            "aktiv": bool(
                body.get(
                    "aktiv",
                    mod.aktiv_standard
                )
            ),

            "werte": werte,

            "berechnungen": berechnungen,

            # Kompatibilität
            "zellen": (
                berechnungen[0]["zellen"]
                if berechnungen
                else {}
            ),
        }

        # Im Arbeitsspeicher aktualisieren
        CONFIG[module_id] = config

        return {
            "ok": True,
            "anzahl": len(berechnungen),
            "gespeichert": True,
        }

    except HTTPException:
        raise

    except Exception as e:

        raise HTTPException(
            400,
            str(e)
        )


