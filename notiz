@app.get(
    "/api/modules",
    dependencies=[Depends(ui_auth)]
)
def list_modules():

    result = []

    for mod in Module.registry.values():

        result.append({
            "id": mod.id,
            "name": mod.name,
            "description": mod.description,

            "inputs": [
