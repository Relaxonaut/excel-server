### B. `save()` vollständig ersetzen

Deine bisherige Funktion `save()` sucht noch nach den alten IDs `a_` und `c_`. Diese existieren in deinem neuen UI nicht mehr.

Ersetze sie durch:

javascript

```javascript

async function saveModule(moduleId) {

  const module = MODS.find(m => m.id === moduleId);

  const message = document.getElementById(
    `msg_${moduleId}`
  );

  if (!module) return;

  try {

    message.textContent = "Speichere ...";
    message.className = "";

    // Alle Berechnungen aus dem UI auslesen
    const berechnungen =
      (module.config.berechnungen || [])
        .map(instance => readInstance(module, instance));

    // Globale Einstellungen auslesen
    const werte = {};

    module.settings.forEach(field => {

      const element = document.getElementById(
        `s_${moduleId}_${field.name}`
      );

      werte[field.name] = readSetting(field, element);

    });

    // Gesamte Konfiguration
    const body = {

      aktiv: document.getElementById(
        `active_${moduleId}`
      ).checked,

      werte,

      berechnungen

    };

    // An Server senden
    const result = await api(
      `/api/modules/${moduleId}`,
      {
        method: "PUT",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(body)
      }
    );

    // Lokale Konfiguration aktualisieren
    module.config.aktiv = body.aktiv;
    module.config.werte = body.werte;
    module.config.berechnungen = body.berechnungen;

    module.config.zellen =
      berechnungen[0]?.zellen || {};

    message.textContent =
      `✓ ${result.anzahl} Berechnungen gespeichert`;

    message.className = "success";

    showStatus(await api("/api/status"));

  } catch (error) {

    message.textContent =
      "Fehler: " + error.message;

    message.className = "error";

  }
}
```

### C. `drawFormulas()` ersetzen

Das ist wichtig, damit auch für die zweite, dritte und weitere Berechnungen eigene Excel-Formeln angezeigt werden.

javascript

```javascript

function drawFormulas() {

  const language = FN[$("#lang").value];

  MODS.forEach(module => {

    const container = $(`#fx_${module.id}`);

    if (!container) return;

    const instances =
      module.config.berechnungen || [];

    let html = "";

    instances.forEach((instance, index) => {

      const prefix =
        `${module.id}.berechnung_${index + 1}`;

      html += `
        <h4>${esc(instance.name)}</h4>
      `;

      (module.outputs || []).forEach(output => {

        const formula =
          `=${language.VLOOKUP}("${prefix}.${output.name}"` +
          `${language.sep}Ergebnis${language.sep}2` +
          `${language.sep}${language.FALSE})`;

        html += `
          <div class="out">

            <b>${esc(output.label)}</b>

            <code class="block">${esc(formula)}</code>

            <button onclick="copyEl(this)">
              Kopieren
            </button>

          </div>
        `;

      });

    });

    container.innerHTML = html;

  });
}
```

