## 2. `ui.html` anpassen

Dein bisheriges HTML hat noch einen alten Speichermechanismus. Deshalb müssen wir drei Funktionen ergänzen bzw. ersetzen.

### A. Diese Hilfsfunktionen hinzufügen

Füge sie direkt unter `renderInstance()` ein:

javascript

```javascript

function newId() {
  return "calc_" +
    Date.now().toString(36) + "_" +
    Math.random().toString(36).slice(2, 8);
}


// Eine Berechnung aus dem UI auslesen
function readInstance(module, instance) {

  const nameElement = document.getElementById(
    `name_${module.id}_${instance.id}`
  );

  const activeElement = document.getElementById(
    `active_${module.id}_${instance.id}`
  );

  const zellen = {};

  module.inputs.forEach(field => {

    const element = document.getElementById(
      `cell_${module.id}_${instance.id}_${field.name}`
    );

    zellen[field.name] = element
      ? element.value.trim()
      : (instance.zellen?.[field.name] || field.cell || "");

  });

  return {
    id: instance.id,
    name: nameElement ? nameElement.value : instance.name,
    aktiv: activeElement ? activeElement.checked : true,
    zellen
  };
}


// Berechnung entfernen
function removeCalculation(moduleId, instanceId) {

  const module = MODS.find(m => m.id === moduleId);

  if (!module) return;

  module.config.berechnungen =
    (module.config.berechnungen || [])
      .map(instance => readInstance(module, instance))
      .filter(instance => instance.id !== instanceId);

  renderModules();
}
